{
  "schema": "panetone.channel-routing.v1",
  "route_cases": [
    {
      "name": "telegram_is_default_without_signal_binding",
      "source": null,
      "telegram_topic": 101,
      "signal_enabled": false,
      "signal_group": null,
      "debate_enabled": false,
      "debate_tabs": [],
      "slack_enabled": false,
      "slack_channel": null,
      "expected": ["tg", 101, "Alpha"]
    },
    {
      "name": "signal_is_default_when_bound",
      "source": null,
      "telegram_topic": 101,
      "signal_enabled": true,
      "signal_group": "signal-alpha",
      "debate_enabled": false,
      "debate_tabs": [],
      "slack_enabled": false,
      "slack_channel": null,
      "expected": ["sig", "signal-alpha", ""]
    },
    {
      "name": "explicit_telegram_overrides_signal_default",
      "source": "tg",
      "telegram_topic": 101,
      "signal_enabled": true,
      "signal_group": "signal-alpha",
      "debate_enabled": false,
      "debate_tabs": [],
      "slack_enabled": false,
      "slack_channel": null,
      "expected": ["tg", 101, "Alpha"]
    },
    {
      "name": "debate_requires_enabled_matching_tab",
      "source": "debate",
      "telegram_topic": 101,
      "signal_enabled": false,
      "signal_group": null,
      "debate_enabled": true,
      "debate_tabs": ["alpha"],
      "debate_chat": -100123,
      "slack_enabled": false,
      "slack_channel": null,
      "expected": ["debate", -100123, ""]
    },
    {
      "name": "slack_requires_live_direct_binding",
      "source": "slack",
      "telegram_topic": 101,
      "signal_enabled": false,
      "signal_group": null,
      "debate_enabled": false,
      "debate_tabs": [],
      "slack_enabled": true,
      "slack_channel": "C012345",
      "expected": ["slack", "C012345", ""]
    },
    {
      "name": "unavailable_selected_destination_does_not_fall_back",
      "source": "sig",
      "telegram_topic": 101,
      "signal_enabled": true,
      "signal_group": null,
      "debate_enabled": false,
      "debate_tabs": [],
      "slack_enabled": false,
      "slack_channel": null,
      "expected": null
    }
  ],
  "format_cases": {
    "slack_markdown_table": {
      "input": "Before\n| Name | Value |\n| --- | ---: |\n| alpha | 1 |\n| b | 22 |\nAfter",
      "expected": "Before\nName   Value\nalpha  1    \nb      22   \n\nAfter"
    },
    "signal_group_ids": [
      {"input": "group==", "expected": "group"},
      {"input": " group= ", "expected": "group"},
      {"input": "", "expected": ""},
      {"input": null, "expected": ""}
    ],
    "line_chunks": {
      "input": "one\ntwo\nthree",
      "limit": 8,
      "expected": ["one\ntwo", "three"]
    },
    "utf16_chunks": {
      "input": "A😀BC",
      "limit": 3,
      "expected": ["A😀", "BC"]
    }
  },
  "retry_fairness": {
    "items": [
      ["tg", 101, "tg-1", 11, "codex", "alpha", "item-1"],
      ["tg", 101, "tg-2", 11, "codex", "alpha", "item-2"],
      ["tg", 102, "tg-other", 12, "claude", "beta", "item-3"],
      ["sig", "group-a", "sig-1", 11, "codex", "", "item-4"],
      ["sig", "group-a", "sig-2", 11, "codex", "", "item-5"],
      ["slack", "C012345", "slack-1", 13, "gemini", "", "item-6"]
    ],
    "expected_attempt_ids": ["item-1", "item-4", "item-6"]
  }
}
