{
  "schema": "panetone.conformance.control.v1",
  "cases": [
    {
      "name": "success_and_duplicate",
      "request": {
        "schema": "panetone.control.v1",
        "id": "11111111-1111-4111-8111-111111111111",
        "method": "send",
        "params": {
          "from": "source",
          "to": "target",
          "message": "hello"
        }
      },
      "replays": [
        {}
      ],
      "expected": {
        "schema": "panetone.control.v1",
        "id": "11111111-1111-4111-8111-111111111111",
        "ok": true,
        "result": {
          "accepted": true,
          "reply_pending": false
        }
      },
      "expected_effects": 1
    },
    {
      "name": "different_content_conflicts",
      "request": {
        "schema": "panetone.control.v1",
        "id": "22222222-2222-4222-8222-222222222222",
        "method": "send",
        "params": {
          "from": "source",
          "to": "target",
          "message": "original"
        }
      },
      "replays": [
        {
          "request": {
            "schema": "panetone.control.v1",
            "id": "22222222-2222-4222-8222-222222222222",
            "method": "send",
            "params": {
              "from": "source",
              "to": "target",
              "message": "changed"
            }
          },
          "expected": {
            "schema": "panetone.control.v1",
            "id": "22222222-2222-4222-8222-222222222222",
            "ok": false,
            "error": {
              "code": "idempotency_conflict",
              "message": "this request id was already used with different content",
              "details": {
                "state": "succeeded"
              }
            }
          }
        }
      ],
      "expected": {
        "schema": "panetone.control.v1",
        "id": "22222222-2222-4222-8222-222222222222",
        "ok": true,
        "result": {
          "accepted": true,
          "reply_pending": false
        }
      },
      "expected_effects": 1
    },
    {
      "name": "unknown_additive_params_are_ignored",
      "request": {
        "schema": "panetone.control.v1",
        "id": "33333333-3333-4333-8333-333333333333",
        "method": "send",
        "params": {
          "from": "source",
          "to": "target",
          "message": "additive",
          "future_hint": "ignored"
        }
      },
      "replays": [
        {
          "request": {
            "schema": "panetone.control.v1",
            "id": "33333333-3333-4333-8333-333333333333",
            "method": "send",
            "params": {
              "from": "source",
              "to": "target",
              "message": "additive"
            }
          }
        }
      ],
      "expected": {
        "schema": "panetone.control.v1",
        "id": "33333333-3333-4333-8333-333333333333",
        "ok": true,
        "result": {
          "accepted": true,
          "reply_pending": false
        }
      },
      "expected_effects": 1
    },
    {
      "name": "semantic_defaults",
      "request": {
        "schema": "panetone.control.v1",
        "id": "44444444-4444-4444-8444-444444444444",
        "method": "send",
        "params": {
          "from": "source",
          "to": "target",
          "message": "defaults"
        }
      },
      "replays": [
        {
          "request": {
            "schema": "panetone.control.v1",
            "id": "44444444-4444-4444-8444-444444444444",
            "method": "send",
            "params": {
              "from": "source",
              "to": "target",
              "message": "defaults",
              "return_final": false,
              "timeout_ms": 0
            }
          },
          "expected_by_profile": {
            "python-current": {
              "schema": "panetone.control.v1",
              "id": "44444444-4444-4444-8444-444444444444",
              "ok": false,
              "error": {
                "code": "idempotency_conflict",
                "message": "this request id was already used with different content",
                "details": {
                  "state": "succeeded"
                }
              }
            },
            "target": {
              "schema": "panetone.control.v1",
              "id": "44444444-4444-4444-8444-444444444444",
              "ok": true,
              "result": {
                "accepted": true,
                "reply_pending": false
              }
            }
          }
        }
      ],
      "expected": {
        "schema": "panetone.control.v1",
        "id": "44444444-4444-4444-8444-444444444444",
        "ok": true,
        "result": {
          "accepted": true,
          "reply_pending": false
        }
      },
      "expected_effects": 1
    },
    {
      "name": "restart_after_possible_delivery_is_indeterminate",
      "request": {
        "schema": "panetone.control.v1",
        "id": "55555555-5555-4555-8555-555555555555",
        "method": "send",
        "params": {
          "from": "source",
          "to": "target",
          "message": "__hold_after_effect__"
        }
      },
      "crash_after_effect": true,
      "expected_after_restart": {
        "schema": "panetone.control.v1",
        "id": "55555555-5555-4555-8555-555555555555",
        "ok": false,
        "error": {
          "code": "request_indeterminate",
          "message": "the service restarted or lost contact during this request; it will not be retried automatically",
          "details": {
            "last_state": "delivering",
            "progress": {
              "source": "source",
              "target": "target"
            }
          }
        }
      },
      "expected_effects": 1
    },
    {
      "name": "return_registration_acknowledges_pending",
      "request": {
        "schema": "panetone.control.v1",
        "id": "66666666-6666-4666-8666-666666666666",
        "method": "send",
        "params": {
          "from": "source",
          "to": "target",
          "message": "callback",
          "return_final": true,
          "timeout_ms": 60000
        }
      },
      "expected": {
        "schema": "panetone.control.v1",
        "id": "66666666-6666-4666-8666-666666666666",
        "ok": true,
        "result": {
          "accepted": true,
          "reply_pending": true
        }
      },
      "expected_effects": 1
    },
    {
      "name": "busy_target_admission",
      "request": {
        "schema": "panetone.control.v1",
        "id": "88888888-8888-4888-8888-888888888888",
        "method": "send",
        "params": {
          "from": "source",
          "to": "target",
          "message": "__target_busy__"
        }
      },
      "expected_by_profile": {
        "python-current": {
          "schema": "panetone.control.v1",
          "id": "88888888-8888-4888-8888-888888888888",
          "ok": false,
          "error": {
            "code": "wakterm_delivery_indeterminate",
            "message": "the target was busy after the audit and current Python cannot queue it safely"
          }
        },
        "target": {
          "schema": "panetone.control.v1",
          "id": "88888888-8888-4888-8888-888888888888",
          "ok": true,
          "result": {
            "accepted": true,
            "delivery_state": "queued",
            "submitted": false,
            "reply_pending": false
          }
        }
      },
      "expected_effects_by_profile": {
        "python-current": 1,
        "target": 0
      }
    }
  ]
}
