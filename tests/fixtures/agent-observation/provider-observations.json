{
  "schema": "panetone.provider-observations.v1",
  "format_cases": [
    {
      "name": "claude_text_blocks_keep_order",
      "provider": "claude",
      "record": {
        "type": "assistant",
        "message": {
          "model": "claude-test",
          "content": [
            {"type": "text", "text": " first "},
            {"type": "text", "text": "second"}
          ]
        }
      },
      "expected": "first\nsecond"
    },
    {
      "name": "claude_plan_is_visible",
      "provider": "claude",
      "record": {
        "type": "assistant",
        "message": {
          "model": "claude-test",
          "content": [
            {
              "type": "tool_use",
              "name": "ExitPlanMode",
              "input": {"plan": "Inspect, change, verify."}
            }
          ]
        }
      },
      "expected": "📋 PLAN PROPOSAL:\nInspect, change, verify."
    },
    {
      "name": "claude_synthetic_is_ignored",
      "provider": "claude",
      "record": {
        "type": "assistant",
        "message": {
          "model": "<synthetic>",
          "content": [{"type": "text", "text": "not user-visible"}]
        }
      },
      "expected": null
    },
    {
      "name": "codex_output_text_blocks_keep_order",
      "provider": "codex",
      "record": {
        "type": "response_item",
        "payload": {
          "type": "message",
          "role": "assistant",
          "content": [
            {"type": "output_text", "text": " alpha "},
            {"type": "output_text", "text": "beta"}
          ]
        }
      },
      "expected": "alpha\nbeta"
    },
    {
      "name": "codex_user_message_is_ignored",
      "provider": "codex",
      "record": {
        "type": "response_item",
        "payload": {
          "type": "message",
          "role": "user",
          "content": [{"type": "input_text", "text": "prompt"}]
        }
      },
      "expected": null
    },
    {
      "name": "opencode_text_is_trimmed",
      "provider": "opencode",
      "record": {"type": "text", "text": " response "},
      "expected": "response"
    },
    {
      "name": "opencode_non_text_is_ignored",
      "provider": "opencode",
      "record": {"type": "tool", "text": "not output"},
      "expected": null
    }
  ],
  "jsonl_cases": [
    {
      "name": "partial_record_waits_for_newline",
      "provider": "codex",
      "complete_records": [
        {
          "type": "response_item",
          "payload": {
            "type": "message",
            "role": "assistant",
            "content": [{"type": "output_text", "text": "first"}]
          }
        }
      ],
      "partial_record": {
        "type": "response_item",
        "payload": {
          "type": "message",
          "role": "assistant",
          "content": [{"type": "output_text", "text": "second"}]
        }
      },
      "expected_first": ["first"],
      "expected_after_completion": ["second"]
    }
  ],
  "gemini_cases": [
    {
      "name": "rewritten_prefix_resumes_after_stable_message_id",
      "messages": [
        {"id": "new-prefix", "type": "user", "content": "prompt"},
        {"id": "stable", "type": "gemini", "content": "already observed"},
        {"id": "next", "type": "gemini", "content": " next response "}
      ],
      "cursor": {"kind": "gemini", "index": 2, "last_id": "stable"},
      "expected": ["next response"],
      "expected_index": 3,
      "expected_last_id": "next"
    },
    {
      "name": "missing_cursor_identity_replays_visible_messages",
      "messages": [
        {"id": "one", "type": "user", "content": "prompt"},
        {"id": "two", "type": "gemini", "content": "answer"}
      ],
      "cursor": {"kind": "gemini", "index": 4, "last_id": "gone"},
      "expected": ["answer"],
      "expected_index": 2,
      "expected_last_id": "two"
    }
  ],
  "opencode_cases": [
    {
      "name": "assistant_text_parts_keep_database_order",
      "session_id": "session-test",
      "parts": [
        {"part_id": "p1", "message_id": "m1", "role": "assistant", "data": {"type": "text", "text": "first"}},
        {"part_id": "p2", "message_id": "m2", "role": "user", "data": {"type": "text", "text": "prompt"}},
        {"part_id": "p3", "message_id": "m3", "role": "assistant", "data": {"type": "text", "text": "second"}}
      ],
      "cursor": {"kind": "opencode", "rowid": 0, "part_id": null},
      "expected": ["first", "second"],
      "expected_rowid": 3,
      "expected_part_id": "p3"
    },
    {
      "name": "rebuilt_rowid_identity_resets_cursor",
      "session_id": "session-rebuilt",
      "parts": [
        {"part_id": "new-p1", "message_id": "new-m1", "role": "assistant", "data": {"type": "text", "text": "replayed"}}
      ],
      "cursor": {"kind": "opencode", "rowid": 1, "part_id": "old-p1"},
      "expected": ["replayed"],
      "expected_rowid": 1,
      "expected_part_id": "new-p1"
    }
  ]
}
