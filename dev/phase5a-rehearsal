#!/bin/bash

set -euo pipefail

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
database=${1:-}

if [[ -z $database || ! -f $database ]]; then
    printf 'Usage: dev/phase5a-rehearsal MIGRATED_DATABASE\n' >&2
    exit 2
fi
if [[ -n $(git -C "$repo" status --porcelain --untracked-files=no) ]]; then
    printf '%s\n' 'tracked files must be clean so the release binary identifies an exact commit' >&2
    exit 1
fi

cargo test --locked --all-targets --manifest-path "$repo/Cargo.toml"
cargo clippy --locked --all-targets --manifest-path "$repo/Cargo.toml" -- -D warnings
cargo build --locked --release --manifest-path "$repo/Cargo.toml"
"$repo/deploy/install-system-service.sh" \
    --binary "$repo/target/release/panetone" \
    --database "$database"
"$repo/target/release/panetone" --version
sha256sum "$repo/target/release/panetone" "$repo/deploy/panetone.service" "$database"
printf '%s\n' 'Phase 5A rehearsal passed without installing, starting, stopping, polling, or sending'
